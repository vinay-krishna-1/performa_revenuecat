# PERFORMA — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your production or sandbox credentials.

# 1. Supabase Cloud Configuration
# Retrieve from: Supabase Dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. RevenueCat In-App Purchases Configuration
# Retrieve from: RevenueCat Dashboard -> Project Settings -> API Keys
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=goog_your_google_play_key
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=appl_your_apple_store_key

# 3. Google Maps SDK API Key (Optional override if not using app.json)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy_YOUR_GOOGLE_MAPS_KEY
