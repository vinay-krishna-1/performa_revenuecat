{
  "expo": {
    "name": "Performa",
    "slug": "performa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "performa",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0B0F14",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.performa.app",
      "infoPlist": {
        "UIBackgroundModes": ["location", "fetch"],
        "NSLocationWhenInUseUsageDescription": "Performa uses your location to accurately record your routes, pace, and live competition stats.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Performa records your workout route in the background so you can lock your screen while running, cycling, or walking."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14"
      },
      "package": "com.performa.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "WAKE_LOCK"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY_HERE"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "YOUR_GOOGLE_MAPS_API_KEY_HERE"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Performa records your workout route in the background so you can lock your screen while running, cycling, or walking.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Performa saves your generated athletic performance cards to your Photos.",
          "savePhotosPermission": "Performa saves your generated athletic performance cards to your Photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
